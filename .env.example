# =======================================================
# 🎯 PASSMASTER AI — PRODUCTION ENVIRONMENT CONFIGURATION
# =======================================================

# Web Server & Flask Session Secret
PORT=5050
SECRET_KEY=passmaster_production_master_secret_key_change_me_9921

# -------------------------------------------------------
# 💳 PAYMENT GATEWAY INTEGRATION (PAYSTACK & MONNIFY)
# -------------------------------------------------------
# Get your API keys at: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key

# Monnify Virtual Accounts (For instant direct bank transfers in Nigeria)
# Get your API keys at: https://app.monnify.com/developer
MONNIFY_API_KEY=MK_TEST_replace_with_monnify_api_key
MONNIFY_SECRET_KEY=replace_with_monnify_secret_key
MONNIFY_CONTRACT_CODE=1234567890

# -------------------------------------------------------
# 💬 WHATSAPP CLOUD API (META FOR DEVELOPERS)
# -------------------------------------------------------
# Create your Meta Cloud app at: https://developers.facebook.com/
# Set Webhook Callback URL to: https://your-domain.ng/api/whatsapp/webhook
WHATSAPP_TOKEN=EAAB_replace_with_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=100234567890123
WHATSAPP_VERIFY_TOKEN=passmaster_secure_webhook_verify_token_2025

# -------------------------------------------------------
# 🧠 AI ENGINE / LLM BACKEND (OPTIONAL ADVANCED REASONING)
# -------------------------------------------------------
# If provided, enables dynamic generative deep-reasoning in addition to local Socratic traps
# Supported models: gemini-2.5-pro (default highest reasoning), gemini-1.5-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
